# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 GitHub에 올리지 않습니다(.gitignore).
# 비밀값(키)은 비워 두었습니다. 나머지는 이 프로젝트에서 쓴 기본값입니다.

# 도서관 정보나루 (https://www.data4library.kr) 인증키 — MCP 헤더 X-Auth-Key 로 보냄
# 서버 IP를 정보나루에 등록해야 하루 30,000건까지 호출 가능 (등록 전 500건)
DATA4LIBRARY_AUTH_KEY=
DATA4LIBRARY_DAILY_LIMIT=450

# AWS Bedrock 접속 정보 (LLM·임베딩·평가·RAGAS 공통)
# *_NEW 키가 있으면 그것을 먼저 쓰고, 없으면 기본 AWS_* 키를 씁니다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID_NEW=
AWS_SECRET_ACCESS_KEY_NEW=
AWS_DEFAULT_REGION_NEW=us-east-1

# 모델 (모두 Claude Sonnet 4.5). 막히면 기본 모델 → 대체 모델(global.) → 대체 리전 순서로 시도
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_FALLBACK_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0
AWS_FALLBACK_REGION=ap-northeast-2
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
